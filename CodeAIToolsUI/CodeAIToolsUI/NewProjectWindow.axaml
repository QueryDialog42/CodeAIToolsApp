<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="560" SizeToContent="Height"
        x:Class="CodeAIToolsUI.NewProjectWindow"
        WindowStartupLocation="CenterScreen"
        Title="NewProjectWindow">

    <Window.Styles>

        <!-- Input field style -->
        <Style Selector="TextBox.darkInput">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="CaretBrush" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Label style -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Cancel button style -->
        <Style Selector="Button.cancelBtn">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.cancelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="Button.cancelBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
        </Style>

        <!-- Create (primary) button style -->
        <Style Selector="Button.createBtn">
            <Setter Property="Background" Value="#5B5FC7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.createBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#6C71D8"/>
        </Style>
        <Style Selector="Button.createBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A4EB6"/>
        </Style>

        <!-- Icon button style -->
        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>

    </Window.Styles>

    <!-- DropShadowEffect → BoxShadow -->
    <Border CornerRadius="14"
            Background="#1A1A1F"
            Padding="32,28"
            BoxShadow="0 4 40 0 #99000000">

        <StackPanel>

            <!-- Title -->
            <TextBlock Text="Yeni Proje Oluştur"
                       Foreground="#FFFFFF"
                       FontSize="20"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,24"/>

            <!-- Project Name -->
            <TextBlock Text="Proje adı" Classes="fieldLabel"/>
            <Grid Margin="0,0,0,20">
                <TextBox x:Name="TxtProjectName"
                         Classes="darkInput"
                         Height="44"
                         VerticalContentAlignment="Center"
                         TextChanged="TxtProjectName_TextChanged"/>
                <TextBlock x:Name="PlaceholderName"
                           Text="Proje adını girin"
                           Foreground="#555555"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Description -->
            <TextBlock Text="Açıklama" Classes="fieldLabel"/>
            <Grid Margin="0,0,0,20">
                <TextBox x:Name="TxtDescription"
                         Classes="darkInput"
                         Height="110"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="12,10"
                         TextChanged="TxtDescription_TextChanged"/>
                <TextBlock x:Name="PlaceholderDesc"
                           Text="Proje açıklaması"
                           Foreground="#555555"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           Margin="14,10,0,0"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False"/>
            </Grid>
            
            <!-- Advanced Section -->
            <TextBlock Text="Gelişmiş" Classes="fieldLabel" Margin="0,0,0,8"/>

            <Border Background="#0D0D0D"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,20">
                <StackPanel>

                    <!-- Advanced Toggle Header -->
                    <Button Classes="iconBtn"
                            HorizontalAlignment="Stretch"
                            Padding="12,10"
                            Click="BtnAdvancedToggle_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="GitHub Entegrasyonu (Opsiyonel)"
                                       Foreground="#AAAAAA"
                                       FontSize="13"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                            <Path x:Name="AdvancedArrow"
                                  Grid.Column="1"
                                  Data="M6 9l6 6 6-6"
                                  Stroke="#AAAAAA"
                                  StrokeThickness="1.5"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Collapsible Content -->
                    <StackPanel x:Name="AdvancedPanel"
                                IsVisible="False"
                                Margin="12,0,12,12">

                        <Border Background="#161616"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="Token girerek projenizi otomatik olarak GitHub'a yükleyebilirsiniz. Bu adım tamamen opsiyoneldir."
                                       Foreground="#777777"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="GitHub Token"
                                   Classes="fieldLabel"
                                   Margin="0,0,0,8"/>
                        <Grid>
                            <TextBox x:Name="TxtGitHubToken"
                                     Classes="darkInput"
                                     Height="44"
                                     VerticalContentAlignment="Center"
                                     PasswordChar="●"
                                     TextChanged="TxtGitHubToken_TextChanged"/>
                            <TextBlock x:Name="PlaceholderToken"
                                       Text="ghp_xxxxxxxxxxxxxxxxxxxx"
                                       Foreground="#555555"
                                       FontSize="14"
                                       FontFamily="Segoe UI"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        
                        <!-- Token hata mesajı -->
                        <TextBlock x:Name="TxtTokenError"
                                   Foreground="#FF4D4D"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   Margin="4,6,0,0"
                                   IsVisible="False"
                                   TextWrapping="Wrap"/>
                        
                        <!-- Link Button -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Padding="0,8,0,0"
                                Cursor="Hand"
                                Click="BtnOpenLink_Click">
                            <TextBlock Text="No Token? Get one here"
                                       Foreground="#5B5FC7"
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       TextDecorations="Underline"/>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Collaborators -->
            <TextBlock Text="İşbirlikçiler" Classes="fieldLabel"/>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,10">

                <!-- Add collaborator button -->
                <Button Classes="iconBtn"
                        Width="32" Height="32"
                        Margin="8,0,0,0"
                        ToolTip.Tip="İşbirlikçi ekle"
                        Click="BtnAddCollaborator_Click">
                    <Path Data="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"
                          Fill="#AAAAAA"
                          Width="20" Height="20"
                          Stretch="Uniform"/>
                </Button>

                <!-- Remove collaborator button -->
                <Button Classes="iconBtn"
                        Width="32" Height="32"
                        Margin="4,0,0,0"
                        ToolTip.Tip="İşbirlikçi kaldır"
                        Click="BtnRemoveCollaborator_Click">
                    <Path Data="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm5 11H7v-2h10v2z"
                          Fill="#AAAAAA"
                          Width="20" Height="20"
                          Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- Collaborator search field -->
            <Grid Margin="0,0,0,28">
                <Border Background="#0D0D0D"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"
                              Stroke="#666666"
                              StrokeThickness="1.5"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="12,0,8,0"
                              VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#CCCCCC"
                                 CaretBrush="#CCCCCC"
                                 FontSize="14"
                                 FontFamily="Segoe UI"
                                 Height="44"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,12,0"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock x:Name="PlaceholderSearch"
                                   Grid.Column="1"
                                   Text="İşbirlikçi ara..."
                                   Foreground="#555555"
                                   FontSize="14"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Classes="cancelBtn"
                        Content="İptal"
                        MinWidth="90"
                        Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button Classes="createBtn"
                        Content="Oluştur"
                        MinWidth="100"
                        Click="BtnCreate_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>

</Window>