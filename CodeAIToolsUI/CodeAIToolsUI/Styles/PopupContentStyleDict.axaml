<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BadgeStyle → Classes="badge" -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding"      Value="8,3"/>
    </Style>

    <!-- ActionBtn → Classes="actionBtn" -->
    <Style Selector="Button.actionBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Foreground"      Value="#94a3b8"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="10,7"/>
        <Setter Property="CornerRadius"    Value="6"/>
    </Style>
    <Style Selector="Button.actionBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2d323c"/>
    </Style>
    <Style Selector="Button.actionBtn:pointerover">
        <Setter Property="Foreground" Value="#f1f5f9"/>
    </Style>
    <Style Selector="Button.actionBtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#374151"/>
    </Style>

    <!-- RemoveBtn → Classes="removeBtn" -->
    <Style Selector="Button.removeBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Width"           Value="22"/>
        <Setter Property="Height"          Value="22"/>
        <Setter Property="CornerRadius"    Value="4"/>
    </Style>
    <Style Selector="Button.removeBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#7f1d1d"/>
    </Style>

</Styles>