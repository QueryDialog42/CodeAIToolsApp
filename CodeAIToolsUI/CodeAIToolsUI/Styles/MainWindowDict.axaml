<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgDark"        Color="#1a1d23"/>
            <SolidColorBrush x:Key="BgPanel"       Color="#22262e"/>
            <SolidColorBrush x:Key="BgCard"        Color="#2a2f3a"/>
            <SolidColorBrush x:Key="BgInput"       Color="#323847"/>
            <SolidColorBrush x:Key="AccentBlue"    Color="#3b82f6"/>
            <SolidColorBrush x:Key="AccentRed"     Color="#ef4444"/>
            <SolidColorBrush x:Key="AccentGreen"   Color="#22c55e"/>
            <SolidColorBrush x:Key="TextPrimary"   Color="#e2e8f0"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#94a3b8"/>
            <SolidColorBrush x:Key="TextMuted"     Color="#64748b"/>
            <SolidColorBrush x:Key="BorderColor"   Color="#374151"/>
            <SolidColorBrush x:Key="TerminalGreen" Color="#22c55e"/>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- NavButton -->
    <Style Selector="Button.navBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#94a3b8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="12,12"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="CornerRadius"    Value="4"/>
    </Style>
    <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2a2f3a"/>
    </Style>
    <Style Selector="Button.navBtn:pointerover">
        <Setter Property="Foreground" Value="#e2e8f0"/>
    </Style>

    <!-- ApproveButton -->
    <Style Selector="Button.approveBtn">
        <Setter Property="Background"      Value="#1e3a5f"/>
        <Setter Property="Foreground"      Value="#3b82f6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="14,6"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="CornerRadius"    Value="4"/>
    </Style>
    <Style Selector="Button.approveBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2563eb"/>
    </Style>
    <Style Selector="Button.approveBtn:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- RejectButton -->
    <Style Selector="Button.rejectBtn">
        <Setter Property="Background"      Value="#ef4444"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="14,6"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="CornerRadius"    Value="4"/>
    </Style>
    <Style Selector="Button.rejectBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#dc2626"/>
    </Style>

    <!-- SidebarItem -->
    <Style Selector="Border.sidebarItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding"    Value="12,6"/>
        <Setter Property="Cursor"     Value="Hand"/>
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox.textBoxStyle">
        <Setter Property="Background"      Value="#323847"/>
        <Setter Property="Foreground"      Value="#94a3b8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="10,8"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="CaretBrush"      Value="#e2e8f0"/>
        <Setter Property="CornerRadius"    Value="4"/>
    </Style>

    <!-- NewProjectButton -->
    <Style Selector="Button.newProjectBtn">
        <Setter Property="Background"      Value="#3b82f6"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="14,8"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="CornerRadius"    Value="6"/>
    </Style>
    <Style Selector="Button.newProjectBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2563eb"/>
    </Style>

    <!-- SearchBox -->
    <Style Selector="TextBox.searchBox">
        <Setter Property="Background"      Value="#22262e"/>
        <Setter Property="Foreground"      Value="#94a3b8"/>
        <Setter Property="BorderBrush"     Value="#374151"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,8"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="CaretBrush"      Value="#e2e8f0"/>
        <Setter Property="CornerRadius"    Value="6"/>
    </Style>

    <!-- RejectButtonOutlined -->
    <Style Selector="Button.rejectBtnOutlined">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="#ef4444"/>
        <Setter Property="BorderBrush"     Value="#ef4444"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="CornerRadius"    Value="4"/>
    </Style>
    <Style Selector="Button.rejectBtnOutlined:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#ef4444"/>
    </Style>
    <Style Selector="Button.rejectBtnOutlined:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

</Styles>