<SyntaxDefinition name="Java" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Comment" foreground="#FF595959"/>
	<Color name="String" foreground="#FFCC9619"/>
	<Color name="Keyword" foreground="#FFFB00E9" fontWeight="bold"/>
	<Color name="Politics" foreground="#FFFB809C"/>
	<Color name="Type" foreground="#4EC9B0"/>
	<Color name="Number" foreground="#FF88CC82"/>
	<Color name="Variables" foreground="#FFCBCC3E" />
	<Color name="Booleans" foreground="#FF4B50FF" />
	<Color name="functions" foreground="#FF0EFBFF" />
	<Color name="functionBody" foreground="#FFF5FF37" fontStyle="italic"/>
	<Color name="Main" foreground="#306eff" fontWeight="bold"/>
	<Color name="Exit" foreground="#FFFB484B" fontWeight="bold"/>
	<Color name="Classes" foreground="#FF8EFBA1"/>
	<Color name="Operators" foreground="#FFD1F5FB"/>
	<Color name="Import" foreground="#f5903d"/>

	<RuleSet>
		<Span color="Comment" begin="//" end="\n"/>
		<Span color="Comment" begin="#.*" end="\n"/>
		<Span color="Comment" multiline="true" begin="/\*" end="\*/"/>
		<Span color="String" begin="&quot;" end="&quot;"/>
		<Rule color="Number">\b[0-9]+\b</Rule>
		<Rule color="functionBody">\b\w+(?=\s*\()</Rule>

		<Keywords color="Keyword">	
			<Word>if</Word>
			<Word>IF:</Word>
			<Word>ELIF:</Word>
			<Word>ELSE:</Word>
			<Word>else</Word>
			<Word>END</Word>
			<Word>for</Word>
			<Word>FOR:</Word>
			<Word>NEXT</Word>
			<Word>while</Word>
			<Word>WHILE:</Word>
			<Word>BREAK</Word>
			<Word>RETURN:</Word>
			<Word>UNTIL:</Word>
			<Word>DONE</Word>
			<Word>return</Word>
			<Word>new</Word>
			<Word>CHECK:</Word>
			<Word>YES:</Word>
			<Word>NO:</Word>
			<Word>BUT:</Word>
		</Keywords>
			
		<Keywords color="Politics">
			<Word>public</Word>
			<Word>private</Word>
			<Word>static</Word>
			<Word>await</Word>
			<Word>class</Word>
		</Keywords>

		<Keywords color="Import">
			<Word>import</Word>
		</Keywords>

		<Keywords color="Variables">
			<Word>int</Word>
			<Word>boolean</Word>
		</Keywords>

		<Keywords color="Booleans">
			<Word>true</Word>
			<Word>false</Word>
		</Keywords>

		<Keywords color="functions">
			<Word>DEF:</Word>
			<Word>SAY:</Word>
			<Word>GET:</Word>
			<Word>CALL:</Word>
			<Word>void</Word>
			<Word>async</Word>
			<Word>protected</Word>
		</Keywords>

		<Keywords color="Exit">
			<Word>EXIT</Word>
		</Keywords>

		<Keywords color="Main">
			<Word>MAIN</Word>
		</Keywords>

		<Keywords color="Classes">
			<Word>String</Word>
			<Word>Integer</Word>
			<Word>USE:</Word>
			<Word>AGAIN</Word>
		</Keywords>

		<Keywords color="Operators">
			<Word>AND</Word>
			<Word>OR</Word>
		</Keywords>
	</RuleSet>
</SyntaxDefinition>
